{
  "name": "checkin-mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.13",
    "expo": "~57.0.8",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.7",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.6",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-appwrite": "0.10.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.4.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "node-appwrite": "17.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "eas:login": "eas login",
    "eas:info": "eas project:info",
    "eas:android:preview": "eas build --platform android --profile preview",
    "eas:android:production": "eas build --platform android --profile production",
    "eas:android:dev": "eas build --platform android --profile development",
    "eas:update:preview": "eas update --channel preview --environment preview",
    "eas:update:production": "eas update --channel production --environment production",
    "setup:appwrite": "node scripts/setup-appwrite-schema.mjs",
    "setup:appwrite:recreate": "node scripts/setup-appwrite-schema.mjs --recreate",
    "seed:appwrite": "node scripts/seed-appwrite-demo.mjs",
    "reset:appwrite": "node scripts/setup-appwrite-schema.mjs --recreate && node scripts/seed-appwrite-demo.mjs --clear --days=90"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@gorhom/bottom-sheet|react-native-reanimated|react-native-gesture-handler)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "private": true,
  "overrides": {
    "react-native-appwrite": {
      "expo-file-system": "~57.0.1"
    }
  }
}
