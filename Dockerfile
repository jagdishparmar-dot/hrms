# Root Dockerfile when Coolify Base Directory is the repo root.
# Builds `my-app`. Prefer Base Directory = `my-app` + my-app/Dockerfile when possible.

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

FROM base AS deps
COPY my-app/package.json my-app/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY my-app/ .

ARG NEXT_PUBLIC_APPWRITE_ENDPOINT
ARG NEXT_PUBLIC_APPWRITE_PROJECT_ID
ARG NEXT_PUBLIC_APPWRITE_DATABASE_ID
ARG NEXT_PUBLIC_APPWRITE_COMPANIES_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_EMPLOYEES_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_AUDIT_LOGS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_SITES_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_ATTENDANCE_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_SHIFTS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_SHIFT_ASSIGNMENTS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_PUNCH_SEGMENTS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_REGULARIZATIONS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_LEAVE_TYPES_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_LEAVE_BALANCES_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_LEAVE_REQUESTS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_HOLIDAYS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_SALARY_STRUCTURES_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_PAYROLL_RUNS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_PAYSLIPS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_PAYSLIPS_BUCKET_ID
ARG NEXT_PUBLIC_APPWRITE_EMPLOYEE_DOCUMENTS_COLLECTION_ID
ARG NEXT_PUBLIC_APPWRITE_EMPLOYEE_DOCUMENTS_BUCKET_ID
ARG NEXT_PUBLIC_APPWRITE_THREE_PL_VENDORS_COLLECTION_ID
ARG NEXT_PUBLIC_APEX_HOSTS

ENV NEXT_PUBLIC_APPWRITE_ENDPOINT=$NEXT_PUBLIC_APPWRITE_ENDPOINT
ENV NEXT_PUBLIC_APPWRITE_PROJECT_ID=$NEXT_PUBLIC_APPWRITE_PROJECT_ID
ENV NEXT_PUBLIC_APPWRITE_DATABASE_ID=$NEXT_PUBLIC_APPWRITE_DATABASE_ID
ENV NEXT_PUBLIC_APPWRITE_COMPANIES_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_COMPANIES_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_EMPLOYEES_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_EMPLOYEES_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_AUDIT_LOGS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_AUDIT_LOGS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_SITES_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_SITES_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_ATTENDANCE_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_ATTENDANCE_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_SHIFTS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_SHIFTS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_SHIFT_ASSIGNMENTS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_SHIFT_ASSIGNMENTS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_PUNCH_SEGMENTS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_PUNCH_SEGMENTS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_REGULARIZATIONS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_REGULARIZATIONS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_LEAVE_TYPES_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_LEAVE_TYPES_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_LEAVE_BALANCES_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_LEAVE_BALANCES_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_LEAVE_REQUESTS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_LEAVE_REQUESTS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_HOLIDAYS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_HOLIDAYS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_SALARY_STRUCTURES_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_SALARY_STRUCTURES_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_PAYROLL_RUNS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_PAYROLL_RUNS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_PAYSLIPS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_PAYSLIPS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_PAYSLIPS_BUCKET_ID=$NEXT_PUBLIC_APPWRITE_PAYSLIPS_BUCKET_ID
ENV NEXT_PUBLIC_APPWRITE_EMPLOYEE_DOCUMENTS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_EMPLOYEE_DOCUMENTS_COLLECTION_ID
ENV NEXT_PUBLIC_APPWRITE_EMPLOYEE_DOCUMENTS_BUCKET_ID=$NEXT_PUBLIC_APPWRITE_EMPLOYEE_DOCUMENTS_BUCKET_ID
ENV NEXT_PUBLIC_APPWRITE_THREE_PL_VENDORS_COLLECTION_ID=$NEXT_PUBLIC_APPWRITE_THREE_PL_VENDORS_COLLECTION_ID
ENV NEXT_PUBLIC_APEX_HOSTS=$NEXT_PUBLIC_APEX_HOSTS
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000

CMD ["node", "server.js"]
