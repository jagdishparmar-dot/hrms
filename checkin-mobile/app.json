{
  "expo": {
    "name": "CheckIn",
    "slug": "checkin-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/7ee0ed7a-82ef-49cb-b977-94ff5485fdac",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/images/icon.png",
    "scheme": "checkinmobile",
    "userInterfaceStyle": "light",
    "backgroundColor": "#312E81",
    "ios": {
      "bundleIdentifier": "com.ayersh009.checkinmobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CheckIn uses your location to verify you are within the office geofence when clocking in.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#312E81",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.ayersh009.checkinmobile",
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#312E81"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CheckIn uses your location to verify you are within the office geofence when clocking in."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ee0ed7a-82ef-49cb-b977-94ff5485fdac"
      }
    },
    "owner": "ayersh009"
  }
}
